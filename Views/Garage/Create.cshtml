@model Car
@{
    ViewData["Title"] = "Add Car";
}

<h1 class="display-2 text-center">Add a Car to Your Garage</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Trim" class="form-label"></label>
        <input asp-for="Trim" class="form-control" />
        <span asp-validation-for="Trim" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Horsepower" class="form-label"></label>
        <input asp-for="Horsepower" class="form-control" />
        <span asp-validation-for="Horsepower" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsElectric" class="form-check-input" />
        <label asp-for="IsElectric" class="form-check-label"></label>
    </div>

     <div class="form-check mb-3">
        <input asp-for="IsHybrid" class="form-check-input" />
        <label asp-for="IsHybrid" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Add it</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}